{
  "manifest_version": 3,
  "name": "歌枠タイムスタンプ検出",
  "version": "0.1.0",
  "description": "YouTube動画の音量変化を検出し、楽曲開始のタイムスタンプ候補を生成します",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.google.com/*",
    "https://www.google.co.jp/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8000/manage/archives*",
        "http://127.0.0.1:8000/manage/archives*"
      ],
      "js": ["content-ycs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*"
      ],
      "js": ["content-google.js"],
      "run_at": "document_start"
    }
  ]
}
